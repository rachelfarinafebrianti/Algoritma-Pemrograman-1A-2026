<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Brankas sKrasny - Sederhana"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value="Program sederhana validasi brankas sKrasny"/>
        <attribute name="saved" value="2026-10-03 09:43:27 PM"/>
        <attribute name="created" value="QVNVUztHQVJULVNTRDsyMDI2LTEwLTAzOzA5OjMxOjQ2IFBNOzIxNzg="/>
        <attribute name="edited" value="QVNVUztHQVJULVNTRDsyMDI2LTEwLTAzOzA5OjQzOjI3IFBNOzE7MjI4OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, digit1, digit2, digit3, pelacakAwal, pelacakTahap1, nilaiAkhir" type="Integer" array="False" size=""/>
            <output expression="&quot;SISTEM BRANKAS sKrasny&quot;" newline="True"/>
            <output expression="&quot;Masukkan kode 3 digit: &quot;" newline="False"/>
            <input variable="kode"/>
            <assign variable="digit1" expression="kode / 100"/>
            <assign variable="digit2" expression="(kode / 10) % 10"/>
            <assign variable="digit3" expression="kode % 10"/>
            <output expression="&quot;Digit pertama: &quot; &amp; digit1" newline="True"/>
            <output expression="&quot;Digit kedua: &quot; &amp; digit2" newline="True"/>
            <output expression="&quot;Digit ketiga: &quot; &amp; digit3" newline="True"/>
            <assign variable="pelacakAwal" expression="digit1 * digit3"/>
            <output expression="&quot;Pelacak awal: &quot; &amp; pelacakAwal" newline="True"/>
            <if expression="digit2 % 2 = 1">
                <then>
                    <assign variable="pelacakTahap1" expression="pelacakAwal + 25"/>
                </then>
                <else>
                    <assign variable="pelacakTahap1" expression="pelacakAwal - digit2"/>
                </else>
            </if>
            <output expression="&quot;Pelacak tahap 1: &quot; &amp; pelacakTahap1" newline="True"/>
            <if expression="pelacakTahap1 % 3 = 0">
                <then>
                    <assign variable="nilaiAkhir" expression="pelacakTahap1 / 3"/>
                </then>
                <else>
                    <assign variable="nilaiAkhir" expression="pelacakTahap1 * 2"/>
                </else>
            </if>
            <output expression="&quot;Nilai akhir: &quot; &amp; nilaiAkhir" newline="True"/>
            <if expression="nilaiAkhir &gt; 50">
                <then>
                    <output expression="&quot;Status sKrasny: Kategori A&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="nilaiAkhir &gt; 20">
                        <then>
                            <output expression="&quot;Status sKrasny: Kategori B&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Status sKrasny: sKrasny Ditolak&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="nilaiAkhir % 2 = 0">
                <then>
                    <output expression="&quot;Siklus Genap&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Siklus Ganjil&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
